# ---------------------------------------------------------------------------
# API keys do NOT belong here any more.
# ---------------------------------------------------------------------------
# Every vendor key (Glenigan, Barbour ABI, ConstructConnect, SAM.gov, Anthropic,
# Apollo, Hunter, Twilio, Socrata, Google OAuth) is entered in
# /control/settings → API Keys and stored AES-256-GCM encrypted in the
# database. Nothing reads them from the environment, so setting one here has no
# effect — it would look configured and resolve to nothing.
#
# Upgrading an install that still has keys in this file? Run this once, then
# delete them:
#
#   node --env-file=.env.local --experimental-transform-types --no-warnings \
#     --import ./scripts/lib/register-alias.mjs \
#     scripts/import-env-credentials.mjs
#
# Then confirm with `npm run verify:secrets`.
#
# What remains below is the database connection plus non-secret operational
# config — the things that must exist before any database read can happen, and
# so cannot themselves live in the database.
# ---------------------------------------------------------------------------

# The database connection.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Authenticates the scheduler. This one stays an environment variable on
# purpose: /api/cron must authenticate BEFORE any database read, so it cannot
# come from the encrypted store. With it unset the endpoint refuses to run.
CRON_SECRET=

# Optional. Separates the encryption key from the database key; by default the
# master key is derived (HKDF-SHA256) from SUPABASE_SECRET_KEY. Set PREVIOUS
# during a rotation so old rows still decrypt, then run Re-encrypt in Settings.
CREDENTIALS_MASTER_KEY=
CREDENTIALS_MASTER_KEY_PREVIOUS=

# Optional. Pins the session cookie's signing key instead of letting the app
# generate and store one on first sign-in. A stored key always wins over this.
SESSION_SIGNING_KEY=

# Folder the GEM "Load from server folder" button reads tracker files from.
# Defaults to this project's ./data/gem when unset. Set an absolute path to
# read GEM exports kept outside the repo. Drag-and-drop upload needs no config.
GEM_DATA_DIR=

# Non-secret model and endpoint overrides.
ENRICH_MODEL=claude-opus-4-8
CALL_PREP_MODEL=
APOLLO_BASE_URL=https://api.apollo.io/api/v1

# Where the collector workflows live. Set this after renaming the repository —
# GitHub redirects git and browser traffic, but a REST workflow dispatch to the
# old slug 404s, so the Collect button needs the current name. Defaults to
# evercam/Gtm-Radar_tool on main.
GITHUB_REPO=
GITHUB_REPO_BRANCH=
