NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
BARBOUR_ABI_USERNAME=
BARBOUR_ABI_PASSWORD=
BARBOUR_ABI_API_KEY=
BARBOUR_ABI_BASE_URL=https://api.barbour-abi.com/v4
GLENIGAN_API_KEY=
GLENIGAN_BASE_URL=https://www.gleniganapi.com/glenigan
CONSTRUCT_CONNECT_API_KEY=
CONSTRUCT_CONNECT_BASE_URL=https://api.io.constructconnect.com/search/v1
SAM_GOV_API_KEY=
SAM_GOV_BASE_URL=https://api.sam.gov/opportunities/v2/search

# Keyless US municipal permit feeds (NYC DOB, Chicago) work with no token.
# Optional Socrata app token only raises the per-IP request throttle.
SOCRATA_APP_TOKEN=

# Folder the GEM "Load from server folder" button reads tracker files from.
# Defaults to this project's ./data/gem when unset. Set an absolute path to
# read GEM exports kept outside the repo. Drag-and-drop upload needs no config.
GEM_DATA_DIR=

# Enrichment engines
ANTHROPIC_API_KEY=
# Optional: override the enrichment model (default claude-opus-4-8)
ENRICH_MODEL=claude-opus-4-8
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io/api/v1
