{
  "name": "ldr_tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:geot": "node scripts/import-geot.mjs",
    "import:secrets": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/import-env-credentials.mjs",
    "verify:secrets": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/verify-secret-sources.mjs",
    "verify:gem": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/verify-gem-health.mjs",
    "ingest:gem": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/ingest-gem-local.mjs",
    "resolve:owners": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/resolve-owner-groups.mjs",
    "verify:owners": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/verify-owner-groups.mjs",
    "diagnose:sources": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/diagnose-sources.mjs",
    "test": "node scripts/run-tests.mjs",
    "backfill:usaspending": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/backfill-usaspending-phase.mjs",
    "ingest:nhs": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/ingest-nhs-infra.mjs",
    "mcp": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/mcp-server.mjs",
    "test:mcp": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/test-mcp.mjs",
    "test:phase-parity": "node --env-file=.env.local --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/test-phase-parity.mjs",
    "gen:phase-sql": "node --experimental-transform-types --no-warnings --import ./scripts/lib/register-alias.mjs scripts/generate-phase-sql.mjs",
    "test:migrations": "bash scripts/test-migrations.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
